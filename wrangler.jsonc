{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanota",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanota-db",
      "database_id": "660dc9b1-c224-4468-86b4-4bc57e1d23dc"
    }
  ],
  "observability": { "enabled": true }
}
